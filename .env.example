# DeutschChat — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
#
# The app compiles and runs without these set; anything that talks to Supabase
# will throw a clear "not configured" error until they are filled in.

# --- Supabase (hosted project) --------------------------------------------
# Create a project at https://supabase.com/dashboard, then:
#   Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Project Settings -> API -> "service_role" secret.
# SERVER ONLY. Bypasses Row Level Security. Never expose to the client,
# never commit.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# --- App -----------------------------------------------------------------
# Public base URL, used for auth redirect callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase CLI (shell env, NOT loaded by Next) -----------------------
# Only needed to run `npm run db:*` against the hosted project:
#   export SUPABASE_ACCESS_TOKEN=...      # https://supabase.com/dashboard/account/tokens
#   npx supabase link --project-ref your-project-ref
#   npx supabase db push                 # apply supabase/migrations/*
#   npm run db:types                     # regenerate types/database.ts
